generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  OWNER
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  orders    Order[]
  createdAt DateTime @default(now())
}

model Canteen {
  id        Int        @id @default(autoincrement())
  name      String
  location  String
  foodItems FoodItem[]
  orders    Order[]
}

model FoodItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String
  available   Boolean     @default(true)
  canteenId   Int
  canteen     Canteen     @relation(fields: [canteenId], references: [id])
  orderItems  OrderItem[]
  predictions Prediction[]
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  canteenId  Int
  pickupSlot String
  status     OrderStatus @default(PLACED)
  total      Float
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  canteen    Canteen     @relation(fields: [canteenId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  foodItemId Int
  quantity   Int
  order      Order    @relation(fields: [orderId], references: [id])
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])
}

model Prediction {
  id               Int      @id @default(autoincrement())
  foodItemId       Int
  date             String
  timeSlot         String
  predictedQuantity Int
  recommendedQty    Int
  confidence       Float
  foodItem         FoodItem @relation(fields: [foodItemId], references: [id])
  createdAt        DateTime @default(now())
}
